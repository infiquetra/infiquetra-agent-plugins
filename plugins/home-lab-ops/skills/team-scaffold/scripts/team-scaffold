#!/usr/bin/env python3
"""Run team-scaffold without an editable install.

PyYAML (the ``pyyaml`` distribution) has to be importable. This file puts the
directory that contains the ``team_scaffold`` package on ``sys.path``, so
``python3 team-scaffold --help`` works from any working directory.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from team_scaffold.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
