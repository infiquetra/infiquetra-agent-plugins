    {
      "id": "correctness.zero-or-empty-breaks-it",
      "lens": "correctness",
      "kind": "yes-no",
      "options": [
        {
          "id": "yes",
          "definition": "a zero, empty, or missing value can break the changed code"
        },
        {
          "id": "no",
          "definition": "zero, empty, and missing values each behave as the contract says"
