  "work_shapes": {
    "judgment": {
      "default_model": "opus",
      "default_effort": "high",
      "rationale": "Judgment, design, adversarial review, architectural decisions \u2014 deep reasoning needed; cost-justified."
    },
    "mechanical": {
      "default_model": "sonnet",
      "default_effort": "medium",
      "rationale": "Mechanical, deterministic, scripted transforms, scaffolding \u2014 bounded output, predictable steps."
    },
    "purely-mechanical": {
      "default_model": "haiku",
      "default_effort": "low",
      "rationale": "Purely mechanical work within the mechanical work-shape \u2014 cheapest tier still safe for bounded, predictable steps."
    },
    "read-only-survey": {
      "default_model": "sonnet",
      "default_effort": "low",
      "rationale": "Read-only survey, search, grep, sampling, census \u2014 low-effort read, no write risk."
    },
    "offload-test-gated": {
      "default_model": "haiku",
      "default_effort": "low",
      "rationale": "External-engine delegation, intent=offload, verifiability=test-gated \u2014 chaperone ratifies the declared test oracle and provenance; keep the chaperone cheap unless evidence size escalates."
    },
    "offload": {
      "default_model": "sonnet",
      "default_effort": "medium",
      "rationale": "External-engine delegation, intent=offload, verifiability=unverifiable or absent \u2014 chaperone performs full review; a heavier default would erase the token savings that motivated delegation (KTD2)."
    },
    "second-opinion": {
      "default_model": "opus",
      "default_effort": "high",
      "rationale": "External-engine delegation, intent=second-opinion \u2014 adversarial verification IS the product; extra spend assumed; fable/xhigh available as a per-unit override, never a default (KTD2)."
    },
    "divergence": {
      "default_model": "opus",
      "default_effort": "high",
      "rationale": "External-engine delegation, intent=divergence \u2014 agreement and disagreement are both explicit adversarial-review outcomes; use the high-tier chaperone posture."
    }
  },
