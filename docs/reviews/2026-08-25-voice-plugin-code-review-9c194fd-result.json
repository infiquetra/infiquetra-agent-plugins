":9.0,"keyboard-focus":10.0,"labels-forms-loading-empty-error-states":8.0},"cycle":1,"delta_check":null,"derived_overall":9.0,"failing_dimensions":[],"lens_id":"accessibility-human-usability","non_applicable_dimensions":{"contrast-zoom-motion-responsiveness":"No graphical or web UI; the surface is a terminal character loop.","localization-content-resilience":"The pane does not parse locale-sensitive input; keys and status are ASCII literals.","semantics-assistive-technology":"No graphical or web UI; the surface is a terminal character loop."},"reviewed_revision":"9c194fdfb1dc06bc28e634d078bc19b7c0e9f143","score_accepted":true,"scoring_findings":[]}],"revision":"9c194fdfb1dc06bc28e634d078bc19b7c0e9f143","unresolved_fix_ids":["fix-7dc84f790a3a","fix-46388b8b1c23","fix-c833265a7e2b","fix-3dc51f50a987"]}],"evidence_ledger":{},"external_advisory_reviews":[],"failing_lenses":[],"findings":[{"autofix_class":"gated_auto","confidence":100,"dimension_id":"recovery","evidence":["plugins/voice/scripts/deliver.py:152","plugins/voice/scripts/deliver.py:159","plugins/voice/scripts/deliver.py:129","plugins/voice/tests/test_deliver.py:359"],"file":"plugins/voice/scripts/deliver.py","finding_id":"F02","lens_id":"adversarial","line":159,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"Keep the hold until deliver returns. Unlink only after a successful send. The blocked branch already re-writes the hold; any other DeliveryRefusal should leave the existing file in place. Add a regression where send-text raises TimeoutExpired after use_refused and the hold still contains the original text.","title":"use_refused drops the hold on send failure","touched_paths":["plugins/voice/scripts/deliver.py","plugins/voice/tests/test_deliver.py"],"why_it_matters":"The hold file is the only remaining copy after transcription deletes the capture wav. Unlinking it before deliver means a herdr timeout, unbound agent, or send-text error consumes the transcript, so the operator cannot retry u and must re-speak."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"graceful-degradation-cancellation-cleanup","evidence":["plugins/voice/scripts/pane.py:265","plugins/voice/scripts/pane.py:271","plugins/voice/scripts/record.py:183","plugins/voice/scripts/process.py:106","docs/evidence/voice/acceptance.md:112"],"file":"plugins/voice/scripts/pane.py","finding_id":"F01","lens_id":"reliability","line":265,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"In pane.run, on q, EOF, and KeyboardInterrupt, abandon any active recorder (SIGTERM, wait even if it is not this process's child, unlink the wav, clear recording.json) without transcribing, and stop playback. Restore recording state from recording.json on pane start. Add a run-loop regression that t then q does not leave a live recorder. Assumption: abandoning on quit matches R12 (no transcribe without an explicit second t) and R25 (ephemeral audio). Leave CLI toggle start-and-exit unchanged.","title":"Pane quit leaves the detached capture running","touched_paths":["plugins/voice/scripts/pane.py","plugins/voice/scripts/record.py","plugins/voice/tests/test_pane.py"],"why_it_matters":"q, EOF, or KeyboardInterrupt tears down the only surface that shows *** RECORDING *** while ffmpeg, spawned with start_new_session, keeps the default microphone open for up to 600 seconds. A later pane paints idle; the next t treats the leftover live pid as an explicit stop and can transcribe post-quit room audio."},{"autofix_class":"advisory","confidence":100,"dimension_id":"interface-contract-compatibility","evidence":["plugins/voice/scripts/preflight.py:188","plugins/voice/scripts/preflight.py:196","plugins/voice/tests/test_preflight.py:41","docs/evidence/voice/acceptance.md:220"],"file":"plugins/voice/scripts/preflight.py","finding_id":"F05","lens_id":"api-contract","line":188,"owner":"downstream-resolver","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"Accept ok: true plus a non-empty backends_loaded list as the usable-backend proof. Already recorded as acceptance F1.","title":"Voice Forge health probe rejects the live /health document","touched_paths":["plugins/voice/scripts/preflight.py","plugins/voice/tests/test_preflight.py"],"why_it_matters":"R22 preflight is supposed to prove Voice Forge before use, but the probe requires status and backend members the deployed v0.3.0 service does not emit, so a healthy synthesizer fails preflight."},{"autofix_class":"advisory","confidence":100,"dimension_id":"specification-documentation-parity","evidence":["plugins/voice/scripts/preflight.py:450","plugins/voice/skills/voice/SKILL.md:57","plugins/voice/tests/test_preflight.py:51","docs/evidence/voice/acceptance.md:225"],"file":"plugins/voice/scripts/preflight.py","finding_id":"F06","lens_id":"api-contract","line":450,"owner":"downstream-resolver","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"Drop the invented stt.provider assertion; keep profile existence if useful, and let the synthesized sample round trip be the STT proof. Qualify SKILL.md so a fail of GET /api/profiles is not a hard unreadiness gate. Already recorded as acceptance F2.","title":"Hermes profile probe expects an stt surface the relay does not publish","touched_paths":["plugins/voice/scripts/preflight.py","plugins/voice/skills/voice/SKILL.md","plugins/voice/tests/test_preflight.py"],"why_it_matters":"The profile probe can never pass against Hermes 0.20.4, and SKILL.md tells an agent that preflight proves the configured profile resolves stt.provider to xai, so a first-use agent treats a working loop as unreadiness."},{"autofix_class":"advisory","confidence":100,"dimension_id":"architectural-fit-ownership-single-sources","evidence":["plugins/voice/scripts/settings.py:161","plugins/voice/scripts/settings.py:19","plugins/voice/README.md:78"],"file":"plugins/voice/scripts/settings.py","finding_id":"F08","lens_id":"architecture-maintainability","line":161,"owner":"downstream-resolver","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"Call settings.retention() from preflight.run_all so a mis-stated posture is refused by name before any audio work. Already recorded as acceptance F7.","title":"VOICE_RETENTION is never consulted at runtime","touched_paths":["plugins/voice/scripts/settings.py","plugins/voice/scripts/preflight.py","plugins/voice/tests/test_preflight.py"],"why_it_matters":"The settings module and README claim the package will not run unless VOICE_RETENTION=ephemeral is stated. retention() is only called from unit tests, so a missing or non-ephemeral value is silently ignored while deletion stays hardcoded."},{"autofix_class":"advisory","confidence":100,"dimension_id":"intent-behavior-completeness","evidence":["plugins/voice/scripts/transcribe.py:226","plugins/voice/tests/test_transcribe.py:262","docs/evidence/voice/acceptance.md:259"],"file":"plugins/voice/scripts/transcribe.py","finding_id":"F07","lens_id":"correctness","line":226,"owner":"downstream-resolver","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"If transcript is empty and provider is missing or null, refuse as nothing to deliver. Keep the substitution refusal only when a non-xai provider string is present. Already recorded as acceptance F3.","title":"Relay silence maps to a provider-mismatch refusal","touched_paths":["plugins/voice/scripts/transcribe.py","plugins/voice/tests/test_transcribe.py"],"why_it_matters":"A quiet room becomes a provider-mismatch alarm. Nothing is delivered, so R23 still holds, but the operator is told the wrong provider ran instead of that there was nothing to deliver."},{"autofix_class":"advisory","confidence":100,"dimension_id":"shipped-behavior-parity","evidence":["docs/README.md:72","README.md:15","README.md:36"],"file":"docs/README.md","finding_id":"F10","lens_id":"documentation-clarity","line":72,"owner":"downstream-resolver","pre_existing":false,"requires_verification":false,"severity":"P3","status":"active","suggested_fix":"Qualify both catalog READMEs: UniFi and Mission Control remain derived/pinned; voice is authored here. Add a voice row to the Packages table. Already recorded as acceptance F9; root README is the same defect, not a new finding. U7 did not own those paths.","title":"Catalog docs still say every plugins/ package is a derived pin","touched_paths":["docs/README.md","README.md"],"why_it_matters":"Voice is authored here with no upstream pin. docs/README.md and the root README still describe the whole plugins/ tree as derived, pinned, and never hand-maintained, and the Packages table omits voice."},{"autofix_class":"safe_auto","confidence":100,"dimension_id":"shipped-behavior-parity","evidence":["plugins/voice/README.md:20","plugins/voice/README.md:26"],"file":"plugins/voice/README.md","finding_id":"F04","lens_id":"documentation-clarity","line":26,"owner":"review-fixer","pre_existing":false,"requires_verification":false,"severity":"P3","status":"active","suggested_fix":"Expand the What is in the package table to the shipped tree: the twelve scripts, tests/ as thirteen unittest modules, skills/voice/SKILL.md, and com.infiquetra.claude/.","title":"Package README inventory is frozen at U1","touched_paths":["plugins/voice/README.md"],"why_it_matters":"The package README is the catalog identity page and still lists only providers.py, settings.py, process.py, and tests for those three modules, while the tree shipped twelve scripts, thirteen test modules, the skill, and the Claude extension."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"graceful-degradation-cancellation-cleanup","evidence":["plugins/voice/com.infiquetra.claude/hooks/stop_hook.py:75","plugins/voice/com.infiquetra.claude/hooks/stop_hook.py:80","plugins/voice/scripts/speak.py:201"],"file":"plugins/voice/com.infiquetra.claude/hooks/stop_hook.py","finding_id":"F03","lens_id":"reliability","line":76,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P3","status":"active","suggested_fix":"After writing the payload, spawn in a try and unlink the payload if spawn_detached raises, then still return 0. Keep the child's finally unlink for the success path. Add a test where spawn raises OSError and no speak-*.json remains.","title":"Stop hook leaves the speak payload if spawn fails","touched_paths":["plugins/voice/com.infiquetra.claude/hooks/stop_hook.py","plugins/voice/tests/test_stop_hook.py"],"why_it_matters":"A failed detach still exits 0, which is correct for the Stop hook, but last_assistant_message remains in the state directory with no consumer because speak.py's finally unlink never runs."},{"autofix_class":"advisory","confidence":100,"dimension_id":"side-effects-errors-resource-lifecycle","evidence":["plugins/voice/scripts/transcribe.py:169","docs/evidence/voice/acceptance.md:155"],"file":"plugins/voice/scripts/transcribe.py","finding_id":"F09","lens_id":"correctness","line":169,"owner":"downstream-resolver","pre_existing":false,"requires_verification":false,"severity":"P3","status":"active","suggested_fix":"Optional stray-capture sweep of capture-*.wav under the state dir after stop/fail. Already recorded as acceptance F6. Distinct from F01 (live recorder after pane quit).","title":"Millisecond flush race can leave an orphan capture wav","touched_paths":["plugins/voice/scripts/transcribe.py"],"why_it_matters":"A killed zero-frame recorder can flush a header-only wav after the transcribe path's finally unlink; the product has no stray-capture sweep."}],"fix_requests":[{"autofix_class":"gated_auto","finding_ids":["F03"],"fix_id":"fix-7dc84f790a3a","owner":"review-fixer","requires_verification":true,"summary":"Stop hook leaves the speak payload if sp