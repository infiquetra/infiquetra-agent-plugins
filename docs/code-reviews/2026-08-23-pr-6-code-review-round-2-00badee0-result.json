t-actionable-errors","safe-bounded-idempotent-resumable-context-cost"],"lens_id":"agent-usability","non_applicable_dimensions":{},"reviewed_revision":"00badee059f5c3c6370ccfd98a432936e472d73a","score_accepted":false,"scoring_findings":[]},{"accepted":false,"applicable_dimensions":{"resolution-completeness":4.0},"cycle":1,"delta_check":null,"derived_overall":4.0,"failing_dimensions":["resolution-completeness"],"lens_id":"previous-comments","non_applicable_dimensions":{},"reviewed_revision":"00badee059f5c3c6370ccfd98a432936e472d73a","score_accepted":false,"scoring_findings":[{"confidence":100,"critical":false,"dimension_id":"resolution-completeness","finding_id":"F-15","priority":"P1","resolved":false}]}],"revision":"00badee059f5c3c6370ccfd98a432936e472d73a","unresolved_fix_ids":["fix-90fd573f7106","fix-91bd19380fec","fix-8dea4e57a7f7","fix-025905c6c7d2"]}],"evidence_ledger":{"behavior-probes":".review/review.md#behavior-probe-evidence","required-gates":".review/review.md#regression-gates","review-artifact":".review/review.md"},"external_advisory_reviews":[],"failing_lenses":["architecture-maintainability","correctness","security","testing","reliability","api-contract","adversarial","privacy","documentation-clarity","agent-usability","previous-comments"],"findings":[{"autofix_class":"manual","confidence":50,"dimension_id":"failure-amplification-silent-green","evidence":["Behavior probe: two executable, byte-identical but inode-distinct Grok wrapper copies on PATH made os.path.samefile return false, and resolve_real_binary returned the second wrapper.","scripts/assess_clients.py:568-574 returns the first later PATH candidate solely because it is not the same file as the first candidate."],"file":"scripts/assess_clients.py","finding_id":"F-11","lens_id":"adversarial","line":568,"owner":"human","pre_existing":false,"requires_verification":true,"severity":"P0","status":"active","suggested_fix":"Do not infer a real Grok or Agy executable from another same-named PATH entry. Require an explicit underlying executable path or a client-specific identity check, refuse every candidate that cannot prove it is not a launcher, and add a copied-wrapper regression test.","title":"Copied launcher wrappers are mistaken for real clients","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"],"why_it_matters":"The resolver treats any later executable that is not the same inode as the first PATH match as the real client. A copied Grok or Agy launcher is therefore accepted and then launches another copy of itself recursively, creating an unbounded chain of descendants until the host exhausts resources."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"graceful-degradation-cancellation-cleanup","evidence":["Real-subprocess probe: a session leader backgrounded a descendant that wrote a marker and then exited; the timeout path reported that the process group had already exited, waited 3.27 seconds, and the descendant wrote the marker.","scripts/assess_clients.py:683-685 resolves the process group through the leader PID after the leader may already have exited."],"file":"scripts/assess_clients.py","finding_id":"F-12","lens_id":"reliability","line":683,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P1","status":"active","suggested_fix":"Because start_new_session makes process.pid the process-group identifier, signal that identifier directly without first calling getpgid; verify the group is gone and add a real-subprocess test whose leader exits before its descendant.","title":"A timed-out descendant survives after its session leader exits","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"],"why_it_matters":"When a launcher exits after starting a descendant, communicate can still time out because that descendant holds the captured pipes. getpgid on the exited leader then fails, so the harness reports that the group exited while the client keeps installing or writing after the deadline."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"state-data-invariants-transactions-concurrency","evidence":["Behavior probe: a first assessment mutated its per-client copy and lost classification; a second assessment with the same workspace kept the marker, classified works-directly, and retained the shipped package fingerprint.","scripts/assess_clients.py:1270-1273 copies only when scratch does not exist, despite the fresh-copy claim at lines 1264-1269 and 1413-1414."],"file":"scripts/assess_clients.py","finding_id":"F-13","lens_id":"correctness","line":1270,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P1","status":"active","suggested_fix":"Allocate a new per-run directory or refuse a non-empty client scratch directory; never reuse an existing package copy. Add a regression that executes two assessments with the same workspace.","title":"A reused workspace silently reuses a mutated package copy","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"],"why_it_matters":"The promised fresh copy is made only when the client directory does not already exist. Reusing --workspace after a client mutation assesses the stale modified tree, can classify it as working, and still binds the record to the shipped tree's digest."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"intent-behavior-completeness","evidence":["Behavior probe: ports/unifi.json with an inert nonexistent assessment entrypoint parsed successfully; simulated placement and load succeeded, the real Python invocation exited 2, and propose_status returned failed.","scripts/port_config.py:535-536 validates entrypoint syntax but not existence; tests/test_port_config.py:438 still checks custody.entrypoint_transforms instead of assessment.entrypoints."],"file":"scripts/port_config.py","finding_id":"F-14","lens_id":"correctness","line":535,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P1","status":"active","suggested_fix":"Validate that every assessment.entrypoints value names a shipped file beneath the package before execution, and change the descriptor regression to iterate config.assessment.entrypoints.","title":"A nonexistent declared entrypoint is graded as a package failure","touched_paths":["scripts/port_config.py","tests/test_port_config.py"],"why_it_matters":"The descriptor parser checks only that an assessment entrypoint is a relative path. A typo survives repository validation, placement and load can succeed, and Python then returns exit status 2 for the nonexistent file, causing the harness to report failed instead of refusing invalid assessment configuration."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"resolution-completeness","evidence":["Behavior probe: when the second command timed out, the outcome retained one recorded command but zero transcript commands.","Behavior probe: after package mutation invalidated a completed stage, the persisted transcript contained no stages.","scripts/assess_clients.py:1062-1075 and 1352-1360 construct replacement StageOutcome values without transcript data."],"file":"scripts/assess_clients.py","finding_id":"F-15","lens_id":"previous-comments","line":1062,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P1","status":"active","suggested_fix":"Carry completed transcript entries into timeout outcomes, add bounded TimeoutExpired output and stderr for the timed-out command, and preserve transcript values while invalidating classification. Add regressions for both branches.","title":"Failure paths discard the transcript needed to finish the record","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"],"why_it_matters":"The timeout return omits both completed-command transcript entries and the timed-out command's partial output. Mutation invalidation then rebuilds every stage without its transcript. These are the paths where operators most need output to explain a blocked row, so the scripted method still cannot produce its required evidence."},{"autofix_class":"gated_auto","confidence":100,"dimension_id":"confidentiality-logs-errors-egress","evidence":["Filesystem probe: an assessment in a user-supplied 0755 workspace created transcript.json with mode 0644 and the other-read bit set.","scripts/assess_clients.py:1431-1437 describes raw unredacted output as private, but line 1437 uses Path.write_text without a restrictive mode."],"file":"scripts/assess_clients.py","finding_id":"F-16","lens_id":"security","line":1437,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P2","status":"active","suggested_fix":"Create transcript.json atomically with mode 0600, preserve that mode on overwrite, and add a permission regression under a permissive umask and operator-supplied workspace.","title":"The raw transcript is not private in an operator-supplied workspace","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"],"why_it_matters":"Path.write_text creates transcript.json according to the process umask. In a normal 0755 operator-supplied workspace it was created as 0644, making unredacted client output readable by other local users despite the explicit private-transcript contract."},{"autofix_class":"safe_auto","confidence":100,"dimension_id":"readability-naming-error-contracts","evidence":["Behavior probe: a version 2 stage whose legacy command equaled commands[0].command yielded two recorded commands and two identical safety problems.","scripts/check_compatibility_matrix.py:798-805 appends command and then every commands entry without schema-aware selection or deduplication."],"file":"scripts/check_compatibility_matrix.py","finding_id":"F-17","lens_id":"architecture-maintainability","line":798,"owner":"review-fixer","pre_existing":false,"requires_verification":true,"severity":"P3","status":"active","suggested_fix":"For version 2 validate commands only, while version 1 continues to validate command, or deduplicate the required legacy alias against commands[0]. Add a diagnostic-count regression.","title":"Version 2 safety validation inspects the first command twice","touched_paths":["scripts/check_compatibility_matrix.py","tests/test_check_compatibility_matrix.py"],"why_it_matters":"Version 2 deliberately keeps command as the first command while also storing that entry in commands. The validator appends both representations, so one unsafe first command produces duplicate diagnostics and inflated problem counts."}],"fix_requests":[{"autofix_class":"manual","finding_ids":["F-11"],"fix_id":"fix-90fd573f7106","owner":"human","requires_verification":true,"summary":"Copied launcher wrappers are mistaken for real clients","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"]},{"autofix_class":"gated_auto","finding_ids":["F-12","F-13","F-15","F-16"],"fix_id":"fix-91bd19380fec","owner":"review-fixer","requires_verification":true,"summary":"A timed-out descendant survives after its session leader exits; A reused workspace silently reuses a mutated package copy; Failure paths discard the transcript needed to finish the record; The raw transcript is not private in an operator-supplied workspace","touched_paths":["scripts/assess_clients.py","tests/test_assess_clients.py"]},{"autofix_class":"gated_auto","finding_ids":["F-14"],"fix_id":"fix-8dea4e57a7f7","owner":"review-fixer","requires_verification":true,"summary":"A nonexistent declared entrypoint is graded as a package failure","touched_paths":["scripts/port_config.py","tests/test_port_config.py"]},{"autofix_class":"safe_auto","finding_ids":["F-17"],"fix_id":"fix-025905c6c7d2","owner":"review-fixer","requires_verification":true,"summary":"Version 2 safety validation inspects the first command twice","touched_paths":["scripts/check_compatibility_matrix.py","tests/test_check_compatibility_matrix.py"]}],"lens_results":[{"