{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/infiquetra/infiquetra-agent-plugins/main/schemas/fleet-bundle.schema.json",
  "title": "Fleet Core build declaration",
  "description": "Closed declaration of which portable Fleet Core modules a consuming plugin bundles at build time. Lives at the consumer plugin root as fleet-bundle.json. This is not an Agent Plugins manifest and must not invent a dependency field there.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "destinations": {
            "description": "Consumer-relative file paths to write. Default: scripts/_bundled/<name>.py.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
